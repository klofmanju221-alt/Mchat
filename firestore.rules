rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.owner == true;
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      // User can read own profile.
      // Owner can read all profiles.
      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isOwner()
        );

      // New users can create only their own profile.
      allow create: if signedIn()
        && request.auth.uid == uid;

      // User can update own profile.
      //
      // Important:
      // User cannot change isOwner or role.
      allow update: if signedIn()
        && (
          isOwner()
          ||
          (
            request.auth.uid == uid
            && request.resource.data.isOwner
                == resource.data.isOwner
            && request.resource.data.role
                == resource.data.role
          )
        );

      allow delete: if false;
    }


    // ============================================================
    // MCHAT ID INDEX
    // ============================================================

    match /mchatIds/{mchatId} {

      // All signed-in users can search Mchat IDs.
      allow read: if signedIn();

      // Normal user creates their own ID.
      //
      // Owner ID 11111111 is allowed only when the
      // user's existing profile is marked as owner.
      allow create: if signedIn()
        && (
          (
            request.auth.uid
                == request.resource.data.uid
            &&
            mchatId.matches(
              '^[0-9]{8}$'
            )
            &&
            mchatId != '11111111'
          )
          ||
          (
            mchatId == '11111111'
            &&
            request.resource.data.uid
                == request.auth.uid
            &&
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.isOwner == true
          )
        );

      // User can update only their own index.
      //
      // Mchat ID and UID can never be changed.
      allow update: if signedIn()
        && request.auth.uid
            == resource.data.uid
        && request.resource.data.uid
            == resource.data.uid
        && request.resource.data.mchatId
            == resource.data.mchatId
        && request.resource.data.mchatId
            == mchatId;

      // IDs cannot be deleted by clients.
      allow delete: if false;
    }


    // ============================================================
    // WALLETS
    // ============================================================

    match /wallets/{uid} {

      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isOwner()
        );

      allow write: if false;
    }


    // ============================================================
    // LEDGER
    // ============================================================

    match /ledger/{entryId} {

      allow read:
          if signedIn() && isOwner();

      allow write: if false;
    }


    // ============================================================
    // RECHARGES
    // ============================================================

    match /recharges/{id} {

      allow read:
          if signedIn() && isOwner();

      allow write: if false;
    }


    // ============================================================
    // WITHDRAWALS
    // ============================================================

    match /withdrawals/{id} {

      allow read:
          if signedIn() && isOwner();

      allow write: if false;
    }


    // ============================================================
    // OWNER COMMISSIONS
    // ============================================================

    match /owner_commissions/{id} {

      allow read:
          if signedIn() && isOwner();

      allow write: if false;
    }


    // ============================================================
    // AUDIT LOGS
    // ============================================================

    match /audit_logs/{id} {

      allow read:
          if signedIn() && isOwner();

      allow write: if false;
    }


    // ============================================================
    // ROOMS
    // ============================================================

    match /rooms/{id} {

      allow read:
          if signedIn();

      allow create:
          if signedIn();

      allow update:
          if signedIn();

      allow delete:
          if isOwner();
    }


    // ============================================================
    // EVERYTHING ELSE BLOCKED
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
