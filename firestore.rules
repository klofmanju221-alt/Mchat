rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // COMMON FUNCTIONS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.owner == true;
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isOwner()
        );

      // User may create only their own account document.
      // Referral information can be supplied during registration.
      allow create: if signedIn()
        && request.auth.uid == uid;

      // Normal users can update their own normal profile fields,
      // but referral/reward/security fields are backend-controlled.
      allow update: if signedIn()
        && (
          isOwner()
          ||
          (
            request.auth.uid == uid

            // Owner/role cannot be changed by normal users.
            && request.resource.data.isOwner
                == resource.data.isOwner

            && request.resource.data.role
                == resource.data.role

            // Referral and reward fields are protected.
            && !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny([
                  'referralCode',
                  'referredByUid',
                  'referredByCode',
                  'referralStatus',
                  'referralCoins',
                  'successfulReferrals',
                  'referralRewardCoins',
                  'referralRejectedReason',
                  'referredAt',
                  'referralUpdatedAt'
                ])
          )
        );

      allow delete: if false;
    }

    // ============================================================
    // MCHAT ID INDEX
    // ============================================================

    match /mchatIds/{mchatId} {

      allow read: if signedIn();

      allow create: if signedIn()
        && (
          (
            request.auth.uid
              == request.resource.data.uid
            && mchatId.matches('^[0-9]{8}$')
            && mchatId != '11111111'
          )
          ||
          (
            mchatId == '11111111'
            && request.resource.data.uid
              == request.auth.uid
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.isOwner == true
          )
        );

      // Mchat ID is immutable.
      allow update: if signedIn()
        && request.auth.uid
          == resource.data.uid
        && request.resource.data.uid
          == resource.data.uid
        && request.resource.data.mchatId
          == resource.data.mchatId
        && request.resource.data.mchatId
          == mchatId;

      allow delete: if false;
    }

    // ============================================================
    // WALLETS
    // ============================================================

    match /wallets/{uid} {

      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isOwner()
        );

      // IMPORTANT:
      // No client can create/update/delete wallet balances.
      // Firebase Admin/backend only.
      allow write: if false;
    }

    // ============================================================
    // LEDGER
    // ============================================================

    match /ledger/{entryId} {

      allow read: if signedIn() && isOwner();

      // Backend only.
      allow write: if false;
    }

    // ============================================================
    // RECHARGES
    // ============================================================

    match /recharges/{id} {

      allow read: if signedIn() && isOwner();

      // Backend/payment verification only.
      allow write: if false;
    }

    // ============================================================
    // WITHDRAWALS
    // ============================================================

    match /withdrawals/{id} {

      allow read: if signedIn() && isOwner();

      // Backend only.
      allow write: if false;
    }

    // ============================================================
    // OWNER COMMISSIONS
    // ============================================================

    match /owner_commissions/{id} {

      allow read: if signedIn() && isOwner();

      // Backend only.
      allow write: if false;
    }

    // ============================================================
    // AUDIT LOGS
    // ============================================================

    match /audit_logs/{id} {

      allow read: if signedIn() && isOwner();

      // Backend only.
      allow write: if false;
    }

    // ============================================================
    // PRIVATE CHAT
    // ============================================================

    match /chats/{chatId} {

      // ----------------------------------------------------------
      // CHAT DOCUMENT
      // ----------------------------------------------------------

      allow read: if signedIn()
        && request.auth.uid
          in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid
          in request.resource.data.participants;

      allow update: if signedIn()
        && request.auth.uid
          in resource.data.participants
        && request.resource.data.participants
          == resource.data.participants;

      allow delete: if false;

      // ----------------------------------------------------------
      // CHAT MESSAGES
      // ----------------------------------------------------------

      match /messages/{messageId} {

        allow read: if signedIn()
          && request.auth.uid
            in get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants;

        allow create: if signedIn()
          && request.auth.uid
            in get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants
          && request.resource.data.senderId
            == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;

        allow update, delete: if false;
      }
    }

    // ============================================================
    // LIVE ROOMS
    // ============================================================

    match /rooms/{roomId} {

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.hostUid
          == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.hostUid == request.auth.uid
          ||
          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'viewerCount',
                'updatedAt'
              ])
            &&
            request.resource.data.viewerCount is int
            &&
            request.resource.data.viewerCount >= 0
          )
        );

      allow delete: if isOwner();

      // ----------------------------------------------------------
      // LIVE ROOM CHAT
      // ----------------------------------------------------------

      match /messages/{messageId} {

        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.senderId
            == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;

        allow update, delete: if false;
      }

      // ----------------------------------------------------------
      // LIVE GIFTS
      // ----------------------------------------------------------

      match /gifts/{giftId} {

        allow read: if signedIn();

        // Gift transactions must be backend controlled.
        allow create, update, delete: if false;
      }

      // ----------------------------------------------------------
      // ROOM MEMBERS
      // ----------------------------------------------------------

      match /members/{memberId} {

        allow read: if signedIn();

        allow create: if signedIn()
          && request.auth.uid == memberId;

        allow update: if signedIn()
          && request.auth.uid == memberId;

        allow delete: if signedIn()
          && (
            request.auth.uid == memberId
            || isOwner()
          );
      }
    }

    // ============================================================
    // EVERYTHING ELSE BLOCKED
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
