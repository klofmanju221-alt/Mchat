rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // COMMON FUNCTIONS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.owner == true;
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------
      //
      // User can read own profile.
      // Owner can read user profiles.
      //

      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isOwner()
        );

      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------
      //
      // Normal user:
      // - Can create only own profile.
      // - Cannot create themselves as owner.
      //
      // Owner:
      // - Can create/update owner profile.
      //

      allow create: if signedIn()
        && (
          isOwner()
          ||
          (
            request.auth.uid == uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.isOwner == false
          )
        );

      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------
      //
      // Three secure paths:
      //
      // 1. Owner can update.
      //
      // 2. Normal user can update normal profile fields only.
      //
      // 3. Existing users can perform a safe one-time
      //    referral profile initialization.
      //

      allow update: if signedIn()
        && (

          // ======================================================
          // 1. OWNER
          // ======================================================

          isOwner()

          ||

          // ======================================================
          // 2. NORMAL USER PROFILE UPDATE
          // ======================================================

          (
            request.auth.uid == uid

            // UID cannot be changed.
            && request.resource.data.uid
                == resource.data.uid

            // Owner status cannot be changed.
            && request.resource.data.isOwner
                == resource.data.isOwner

            // Role cannot be changed.
            && request.resource.data.role
                == resource.data.role

            // Mchat ID cannot be changed.
            && request.resource.data.mchatId
                == resource.data.mchatId

            // Referral/security/financial fields are
            // backend controlled.
            && !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny([
                  'referralCode',
                  'referredByUid',
                  'referredByCode',
                  'referralStatus',
                  'referralCoins',
                  'successfulReferrals',
                  'referralRewardCoins',
                  'referralRejectedReason',
                  'referredAt',
                  'referralUpdatedAt'
                ])
          )

          ||

          // ======================================================
          // 3. SAFE ONE-TIME REFERRAL PROFILE INITIALIZATION
          // ======================================================
          //
          // This allows an existing user whose referral fields
          // are missing to initialize:
          //
          // referralCode
          // successfulReferrals = 0
          // referralCoins = 0
          //
          // The referral code MUST match the user's own Mchat ID.
          //

          (
            request.auth.uid == uid

            // UID cannot change.
            && request.resource.data.uid
                == resource.data.uid

            // Owner status cannot change.
            && request.resource.data.isOwner
                == resource.data.isOwner

            // Role cannot change.
            && request.resource.data.role
                == resource.data.role

            // Mchat ID cannot change.
            && request.resource.data.mchatId
                == resource.data.mchatId

            // Valid normal-user Mchat ID.
            && request.resource.data.mchatId is string
            && request.resource.data.mchatId.matches(
              '^[0-9]{8}$'
            )
            && request.resource.data.mchatId
                != '11111111'

            // Referral code MUST be derived from
            // the same user's Mchat ID.
            && request.resource.data.referralCode
                == 'MCHAT-' + request.resource.data.mchatId

            // Initial counters must be zero.
            && request.resource.data.successfulReferrals == 0
            && request.resource.data.referralCoins == 0

            // Only these fields may change.
            && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'referralCode',
                  'successfulReferrals',
                  'referralCoins',
                  'referralUpdatedAt'
                ])

            // This must be a one-time initialization.
            && !resource.data.keys().hasAll([
              'referralCode',
              'successfulReferrals',
              'referralCoins'
            ])
          )
        );

      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      // User accounts cannot be deleted from client.
      allow delete: if false;

      // ==========================================================
      // REFERRAL HISTORY
      // ==========================================================
      //
      // Path:
      //
      // users/{referrerUid}/referrals/{newUserUid}
      //
      // Referrer can read own referral history.
      // Owner can read referral history.
      //
      // Client cannot create/update/delete history.
      // Backend/Admin SDK only.
      //

      match /referrals/{referralId} {

        allow read: if signedIn()
          && (
            request.auth.uid == uid
            || isOwner()
          );

        allow create, update, delete: if false;
      }
    }

    // ============================================================
    // MCHAT ID INDEX
    // ============================================================

    match /mchatIds/{mchatId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------
      //
      // Signed-in users can search Mchat IDs.
      //

      allow read: if signedIn();

      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------
      //
      // Normal users can create their own 8-digit ID.
      //
      // Owner ID 11111111 is reserved.
      //

      allow create: if signedIn()
        && (
          (
            request.auth.uid
              == request.resource.data.uid
            && request.resource.data.mchatId
              == mchatId
            && mchatId.matches('^[0-9]{8}$')
            && mchatId != '11111111'
            && request.resource.data.isOwner == false
          )
          ||
          (
            isOwner()
            && mchatId == '11111111'
            && request.resource.data.uid
              == request.auth.uid
            && request.resource.data.mchatId
              == '11111111'
            && request.resource.data.isOwner == true
          )
        );

      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------
      //
      // Mchat ID and owner status are immutable.
      //

      allow update: if signedIn()
        && request.auth.uid
          == resource.data.uid
        && request.resource.data.uid
          == resource.data.uid
        && request.resource.data.mchatId
          == resource.data.mchatId
        && request.resource.data.mchatId
          == mchatId
        && request.resource.data.isOwner
          == resource.data.isOwner;

      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if false;
    }

    // ============================================================
    // WALLETS
    // ============================================================

    match /wallets/{uid} {

      // User can read own wallet.
      // Owner can read wallets.
      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isOwner()
        );

      // IMPORTANT:
      //
      // Client cannot create/update/delete wallet balances.
      //
      // Firebase Admin SDK / secure backend only.
      //

      allow write: if false;
    }

    // ============================================================
    // LEDGER
    // ============================================================

    match /ledger/{entryId} {

      // Owner can read financial ledger.
      allow read: if signedIn() && isOwner();

      // Backend only.
      allow write: if false;
    }

    // ============================================================
    // RECHARGES
    // ============================================================

    match /recharges/{id} {

      // Owner can read recharge records.
      allow read: if signedIn() && isOwner();

      // Backend/payment verification only.
      allow write: if false;
    }

    // ============================================================
    // WITHDRAWALS
    // ============================================================

    match /withdrawals/{id} {

      // Owner can read withdrawal records.
      allow read: if signedIn() && isOwner();

      // Backend only.
      allow write: if false;
    }

    // ============================================================
    // OWNER COMMISSIONS
    // ============================================================

    match /owner_commissions/{id} {

      // Owner can read commission records.
      allow read: if signedIn() && isOwner();

      // Backend only.
      allow write: if false;
    }

    // ============================================================
    // AUDIT LOGS
    // ============================================================

    match /audit_logs/{id} {

      // Owner can read security audit logs.
      allow read: if signedIn() && isOwner();

      // Backend only.
      allow write: if false;
    }

    // ============================================================
    // PRIVATE CHAT
    // ============================================================

    match /chats/{chatId} {

      // ----------------------------------------------------------
      // CHAT DOCUMENT
      // ----------------------------------------------------------

      allow read: if signedIn()
        && request.auth.uid
          in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid
          in request.resource.data.participants;

      allow update: if signedIn()
        && request.auth.uid
          in resource.data.participants
        && request.resource.data.participants
          == resource.data.participants;

      allow delete: if false;

      // ----------------------------------------------------------
      // CHAT MESSAGES
      // ----------------------------------------------------------

      match /messages/{messageId} {

        allow read: if signedIn()
          && request.auth.uid
            in get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants;

        allow create: if signedIn()
          && request.auth.uid
            in get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants
          && request.resource.data.senderId
            == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;

        allow update, delete: if false;
      }
    }

    // ============================================================
    // LIVE ROOMS
    // ============================================================

    match /rooms/{roomId} {

      // ----------------------------------------------------------
      // ROOM
      // ----------------------------------------------------------

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.hostUid
          == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.hostUid == request.auth.uid
          ||
          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'viewerCount',
                'updatedAt'
              ])
            &&
            request.resource.data.viewerCount is int
            &&
            request.resource.data.viewerCount >= 0
          )
        );

      allow delete: if isOwner();

      // ----------------------------------------------------------
      // LIVE ROOM CHAT
      // ----------------------------------------------------------

      match /messages/{messageId} {

        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.senderId
            == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;

        allow update, delete: if false;
      }

      // ----------------------------------------------------------
      // LIVE GIFTS
      // ----------------------------------------------------------

      match /gifts/{giftId} {

        allow read: if signedIn();

        // Gift transactions are backend controlled.
        allow create, update, delete: if false;
      }

      // ----------------------------------------------------------
      // ROOM MEMBERS
      // ----------------------------------------------------------

      match /members/{memberId} {

        allow read: if signedIn();

        allow create: if signedIn()
          && request.auth.uid == memberId;

        allow update: if signedIn()
          && request.auth.uid == memberId;

        allow delete: if signedIn()
          && (
            request.auth.uid == memberId
            || isOwner()
          );
      }
    }

    // ============================================================
    // EVERYTHING ELSE BLOCKED
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
