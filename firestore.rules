rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.owner == true;
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isOwner()
        );

      allow create: if signedIn()
        && request.auth.uid == uid;

      allow update: if signedIn()
        && (
          isOwner()
          ||
          (
            request.auth.uid == uid
            && request.resource.data.isOwner
                == resource.data.isOwner
            && request.resource.data.role
                == resource.data.role
          )
        );

      allow delete: if false;
    }


    // ============================================================
    // MCHAT ID INDEX
    // ============================================================

    match /mchatIds/{mchatId} {

      allow read: if signedIn();

      allow create: if signedIn()
        && (
          (
            request.auth.uid
              == request.resource.data.uid
            &&
            mchatId.matches('^[0-9]{8}$')
            &&
            mchatId != '11111111'
          )
          ||
          (
            mchatId == '11111111'
            &&
            request.resource.data.uid
              == request.auth.uid
            &&
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.isOwner == true
          )
        );

      allow update: if signedIn()
        && request.auth.uid
          == resource.data.uid
        && request.resource.data.uid
          == resource.data.uid
        && request.resource.data.mchatId
          == resource.data.mchatId
        && request.resource.data.mchatId
          == mchatId;

      allow delete: if false;
    }


    // ============================================================
    // WALLETS
    // ============================================================

    match /wallets/{uid} {

      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isOwner()
        );

      allow write: if false;
    }


    // ============================================================
    // LEDGER
    // ============================================================

    match /ledger/{entryId} {

      allow read: if signedIn()
        && isOwner();

      allow write: if false;
    }


    // ============================================================
    // RECHARGES
    // ============================================================

    match /recharges/{id} {

      allow read: if signedIn()
        && isOwner();

      allow write: if false;
    }


    // ============================================================
    // WITHDRAWALS
    // ============================================================

    match /withdrawals/{id} {

      allow read: if signedIn()
        && isOwner();

      allow write: if false;
    }


    // ============================================================
    // OWNER COMMISSIONS
    // ============================================================

    match /owner_commissions/{id} {

      allow read: if signedIn()
        && isOwner();

      allow write: if false;
    }


    // ============================================================
    // AUDIT LOGS
    // ============================================================

    match /audit_logs/{id} {

      allow read: if signedIn()
        && isOwner();

      allow write: if false;
    }


    // ============================================================
    // LIVE ROOMS
    // ============================================================

    match /rooms/{roomId} {

      // Signed-in users can see live rooms.
      allow read: if signedIn();

      // A user can create only a room where they are the host.
      allow create: if signedIn()
        && request.resource.data.hostUid
          == request.auth.uid;

      // Host can update their own room.
      allow update: if signedIn()
        && (
          resource.data.hostUid == request.auth.uid
          ||
          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'viewerCount',
                'updatedAt'
              ])
            &&
            request.resource.data.viewerCount is int
            &&
            request.resource.data.viewerCount >= 0
          )
        );

      // Only owner can delete rooms.
      allow delete: if isOwner();


      // ==========================================================
      // LIVE ROOM CHAT
      // ==========================================================

      match /messages/{messageId} {

        // Signed-in users can read live room messages.
        allow read: if signedIn();

        // A user can create a message only as themselves.
        allow create: if signedIn()
          && request.resource.data.senderId
            == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;

        // Messages cannot be edited or deleted by clients.
        allow update, delete: if false;
      }


      // ==========================================================
      // LIVE ROOM GIFTS
      // ==========================================================
      //
      // Client cannot directly create/update gifts.
      // Gifts will later be processed through trusted backend
      // so coins cannot be cheated.
      //

      match /gifts/{giftId} {

        allow read: if signedIn();

        allow create, update, delete: if false;
      }


      // ==========================================================
      // ROOM MEMBERS
      // ==========================================================

      match /members/{memberId} {

        allow read: if signedIn();

        allow create: if signedIn()
          && request.auth.uid == memberId;

        allow update: if signedIn()
          && request.auth.uid == memberId;

        allow delete: if signedIn()
          && (
            request.auth.uid == memberId
            || isOwner()
          );
      }
    }


    // ============================================================
    // EVERYTHING ELSE BLOCKED
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
